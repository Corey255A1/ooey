VBox id=todoRootLayout spacing=15 width="MatchParent" height="MatchParent":
    Label id=titleLabel text=@tr("todo_title")
    HBox id=inputRow spacing=10 width="MatchParent":
        TextBox id=taskInput text=@binding.newTaskText width=300
        Button id=btnAdd text=@tr("add_task") onClick=@signal.addTask
    ListControl id=todoList items=@binding.taskList onSelected=@signal.selectTask(newValue) width="MatchParent" height=300:
        Row id=itemRow spacing=10 width="MatchParent" height=40:
            CheckBox id=taskCheck checked=@binding.taskList.completed text=@binding.taskList.text width=400
            Button id=btnRowDelete text=@tr("delete") onClick=@signal.deleteTask(index)
    HBox id=actionRow spacing=10:
        Button id=btnToggle text=@tr("toggle_done") onClick=@signal.toggleTask
        Button id=btnDelete text=@tr("delete") onClick=@signal.deleteTask
